{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/*.{md,mdc,mdx}", "netlify.toml"],
  "jsdoc": {
    "bracketSpacing": true
  },
  "sortImports": true,
  "sortTailwindcss": { "attributes": [":class"], "functions": ["tv", "tw"] },
  "sortPackageJson": { "sortScripts": true },
  "vueIndentScriptAndStyle": true
}
